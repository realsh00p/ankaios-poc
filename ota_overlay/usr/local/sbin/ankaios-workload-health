#!/usr/bin/env python3
import json
import re
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlparse
from urllib.request import urlopen

HOST = "0.0.0.0"
PORT = 8090
ANK = ["sudo", "ank", "-k", "get", "workloads"]

WORKLOADS = {
    "qemu_1-vm": {"kind": "ankaios"},
    "qemu_2-vm": {"kind": "ankaios"},
    "echo-server-40101": {"kind": "ankaios-http", "url": "http://192.168.10.240:40101"},
    "echo-server-40102": {"kind": "ankaios-http", "url": "http://192.168.10.240:40102"},
    "echo-server-40103": {"kind": "ankaios-http", "url": "http://192.168.10.240:40103"},
    "echo-client-40101": {"kind": "ankaios"},
    "echo-client-40102": {"kind": "ankaios"},
    "echo-client-40103": {"kind": "ankaios"},
}

CONVERGING_STATES = ("Pending", "Starting", "Waiting", "Stopping")
FAILED_STATES = ("Failed", "Removed", "Delete", "Lost", "Unknown")


def ankaios_workloads():
    output = subprocess.check_output(ANK, text=True, timeout=10)
    states = {}
    for line in output.splitlines()[1:]:
        line = line.strip()
        if not line:
            continue
        parts = re.split(r"\s{2,}", line)
        if len(parts) >= 4:
            states[parts[0]] = {
                "agent": parts[1],
                "runtime": parts[2],
                "executionState": parts[3],
                "additionalInfo": parts[4] if len(parts) > 4 else "",
            }
    return states


def functional_probe(url):
    started = time.time()
    with urlopen(url, timeout=5) as response:
        body = response.read(256).decode("utf-8", "replace")
        return {
            "url": url,
            "status": response.status,
            "durationMs": int((time.time() - started) * 1000),
            "sample": body,
        }


def check_workload(name, states=None):
    if name not in WORKLOADS:
        return 404, {
            "workload": name,
            "healthy": False,
            "terminal": True,
            "reason": "unknown workload",
        }

    states = states or ankaios_workloads()
    state = states.get(name)
    if not state:
        return 500, {
            "workload": name,
            "healthy": False,
            "terminal": True,
            "reason": "workload not present in Ankaios state",
        }

    execution = state["executionState"]
    result = {
        "workload": name,
        "healthy": False,
        "terminal": False,
        "ankaios": state,
    }

    if execution.startswith("Running(Ok)") or execution.startswith("Succeeded(Ok)"):
        result["healthy"] = True
        result["terminal"] = False
        result["reason"] = "ankaios state is healthy"
    elif execution.startswith(CONVERGING_STATES):
        result["reason"] = "workload is still converging"
        return 202, result
    elif execution.startswith(FAILED_STATES) or "Failed" in execution:
        result["terminal"] = True
        result["reason"] = "ankaios state is failed"
        return 500, result
    else:
        result["reason"] = "ankaios state is not healthy"
        return 500, result

    probe_url = WORKLOADS[name].get("url")
    if probe_url:
        try:
            probe = functional_probe(probe_url)
            result["probe"] = probe
            if probe["status"] < 200 or probe["status"] >= 300:
                result["healthy"] = False
                result["terminal"] = True
                result["reason"] = "functional probe returned non-2xx"
                return 500, result
        except Exception as exc:
            result["healthy"] = False
            result["terminal"] = True
            result["reason"] = "functional probe failed"
            result["probe"] = {"url": probe_url, "error": str(exc)}
            return 500, result

    return 200, result


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        sys.stderr.write("%s - - [%s] %s\n" % (self.client_address[0], self.log_date_time_string(), fmt % args))

    def send_json(self, status, payload):
        data = json.dumps(payload, indent=2, sort_keys=True).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path.rstrip("/")
        try:
            if path == "/healthz":
                self.send_json(200, {"healthy": True, "service": "ankaios-workload-health"})
                return
            if path == "/health/workloads":
                states = ankaios_workloads()
                results = []
                status = 200
                for name in WORKLOADS:
                    item_status, item = check_workload(name, states)
                    results.append(item)
                    if item_status == 500:
                        status = 500
                    elif item_status == 202 and status == 200:
                        status = 202
                self.send_json(status, {
                    "healthy": status == 200,
                    "workloads": results,
                })
                return
            prefix = "/health/workload/"
            if path.startswith(prefix):
                name = unquote(path[len(prefix):])
                status, payload = check_workload(name)
                self.send_json(status, payload)
                return
            self.send_json(404, {"healthy": False, "reason": "unknown endpoint"})
        except subprocess.TimeoutExpired as exc:
            self.send_json(503, {"healthy": False, "reason": "ank command timed out", "error": str(exc)})
        except Exception as exc:
            self.send_json(500, {"healthy": False, "reason": "health service error", "error": str(exc)})


if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
