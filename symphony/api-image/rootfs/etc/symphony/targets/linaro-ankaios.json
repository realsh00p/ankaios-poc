{
  "metadata": {
    "name": "linaro-ankaios",
    "namespace": "default"
  },
  "spec": {
    "forceRedeploy": true,
    "topologies": [
      {
        "bindings": [
          {
            "role": "instance",
            "provider": "providers.target.sovd",
            "config": {
              "endpoint": "http://127.0.0.1:7690/sovd/v1",
              "component": "ankaios",
              "timeout": "60"
            }
          }
        ]
      }
    ]
  }
}
