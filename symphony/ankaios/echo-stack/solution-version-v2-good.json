        "name": "qemu_1-vm",
        "type": "container",
        "properties": {
          "ankaios.agent": "linaro",
          "ankaios.runtime": "systemd",
          "ankaios.restartPolicy": "ALWAYS",
          "ankaios.runtimeConfig": "serviceName: qemu_1.service"
        }
      },
      {
        "name": "qemu_2-vm",
        "type": "container",
        "properties": {
          "ankaios.agent": "linaro",
