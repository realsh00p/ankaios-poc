        "properties": {
          "container.image": "docker.io/ealen/echo-server:latest",
          "ankaios.agent": "qemu_1",
          "ankaios.runtime": "podman",
          "ankaios.restartPolicy": "ALWAYS",
          "ankaios.dependencies": "qemu_1-vm: ADD_COND_RUNNING",
          "ankaios.runtimeConfig": "image: docker.io/ealen/echo-server:latest\ncommandOptions: [\"--network\", \"host\", \"-e\", \"PORT=40101\"]",
          "health.url": "http://192.168.10.240:40101/health",
          "health.localUrl": "http://127.0.0.1:40101/health"
        }
