{
  "metadata": {
    "name": "linaro-ankaios",
    "namespace": "default"
  },
  "spec": {
    "forceRedeploy": true,
    "topologies": [
      {
        "bindings": [
          {
            "role": "instance",
            "provider": "providers.target.rust",
            "config": {
              "libHash": "any",
              "libFile": "/usr/local/lib/libankaios.so"
            }
          }
        ]
      }
    ]
  }
}
