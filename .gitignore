# Ignore everything by default; explicitly unignore the small text/config
# files and placeholders needed to reconstruct the layout.
*

# Repository metadata
!.gitignore
!README.md
!AGENTS.md
!**/.gitkeep

# QEMU VM scripts and configuration. Disk images, boot binaries, keys,
# downloads, and container storage remain ignored by default.
!qemu_*/
!qemu_*/alpine-podman-qemu.sh
!qemu_*/echo-client/
!qemu_*/echo-client/**
!qemu_*/etc/
!qemu_*/etc/**
!qemu_*/boot/
!qemu_*/boot/.gitkeep
!qemu_*/var/
!qemu_*/var/lib/
!qemu_*/var/lib/containers/
!qemu_*/var/lib/containers/.gitkeep
!qemu_*/work/
!qemu_*/work/.gitkeep

# OTA overlay files mirrored from /home/linaro/ota_overlay.
!ota_overlay/
!ota_overlay/etc/
!ota_overlay/etc/**
ota_overlay/etc/rollback-workload/history/
!ota_overlay/usr/
!ota_overlay/usr/local/
!ota_overlay/usr/local/sbin/
!ota_overlay/usr/local/sbin/**
!ota_overlay/lib/
!ota_overlay/lib/systemd/
!ota_overlay/lib/systemd/system-generators/
!ota_overlay/lib/systemd/system-generators/**


# Symphony API/Opera playground configuration and source.
!symphony/

!symphony/api-image/
!symphony/api-image/Dockerfile
!symphony/api-image/rootfs/
!symphony/api-image/rootfs/etc/
!symphony/api-image/rootfs/etc/symphony-api.json
symphony/api-image/rootfs/lib/
symphony/api-image/rootfs/usr/
symphony/api-image/rootfs/bin/
symphony/api-image/rootfs/sbin/
!symphony/ankaios/
!symphony/ankaios/**
!symphony/campaigns/
!symphony/campaigns/**
!symphony/opera/
!symphony/opera/**
symphony/opera/node_modules/
symphony/opera/.next/
symphony/opera/public/*.png
symphony/opera/public/*.jpg
symphony/opera/public/*.jpeg
symphony/opera/public/*.ico
symphony/opera/public/*.gif
symphony/opera/public/*.webp

# Binary frontend assets are intentionally not committed.
symphony/opera/**/*.ico
symphony/opera/**/*.png
symphony/opera/**/*.jpg
symphony/opera/**/*.jpeg
symphony/opera/**/*.gif
symphony/opera/**/*.webp

# Symphony API config mirrored from /etc into ota_overlay.
!ota_overlay/etc/symphony-api.json

# Helper scripts.
!scripts/
!scripts/*.sh

# Explicit binary/secret/runtime exclusions for clarity.
*.img
*.qcow2
*.raw
*.iso
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
*.xz
*.zst
*.deb
*.apk
*.rpm
*.bin
*.elf
*.dtb
*.dtbo
*.ko
Image-*
vmlinuz-*
initramfs-*
*_ed25519
*_ed25519.pub
*.bak.*
qemu_*/boot/**
!qemu_*/boot/.gitkeep
qemu_*/var/lib/containers/**
!qemu_*/var/lib/containers/.gitkeep
qemu_*/work/**
!qemu_*/work/.gitkeep
lost+found/
recovery/
.resized
wifi_chip
